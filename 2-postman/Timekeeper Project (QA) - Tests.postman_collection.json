              "name": "[NEG-05] Assign con hora de término anterior a la de inicio",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "let body = {};\r\ntry { body = pm.response.json(); } catch (e) {}\r\nconst created = (body.data && body.data.success) ? body.data.success : [];\r\n\r\npm.test(\"NEG horas invertidas: no se crea ningun turno\", () => pm.expect(created).to.be.empty);\r\npm.test(\"NEG horas invertidas: se informa error de validacion\", () => {\r\n  const rechazado = [400, 422].includes(pm.response.code);\r\n  const conErrores = pm.response.code === 200 && body.data && body.data.total_errors > 0;\r\n  pm.expect(rechazado || conErrores, \"Codigo: \" + pm.response.code).to.be.true;\r\n});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
