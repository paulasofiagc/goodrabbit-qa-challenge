                      "pm.test(\"Login: status 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Login: tiempo de respuesta < 1500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1500));\r\npm.test(\"Login: responde JSON\", () => {\r\n  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r\n});\r\n\r\nconst json = pm.response.json();\r\npm.test(\"Login: devuelve access_token\", () => pm.expect(json.access_token).to.be.a(\"string\").and.not.empty);\r\npm.test(\"Login: token_type es bearer\", () => pm.expect(json.token_type).to.eql(\"bearer\"));\r\npm.test(\"Login: incluye expires_in\", () => pm.expect(json.expires_in).to.be.a(\"number\"));\r\n\r\npm.collectionVariables.set(\"bearer_token\", json.access_token);\r\npm.collectionVariables.set(\"refresh_token\", json.refresh_token);\r\npm.collectionVariables.set(\"token_expires_at\", Date.now() + json.expires_in * 1000 - 30000);"
